<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Acesso Administrativo - Lar Semente do Amor</title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="login-container">
    <h1>Acesso Administrativo</h1>
    <p>Entre com suas credenciais</p>

    <form action="/login" method="POST" class="login-form">
      <label for="email">Usuário (E-mail):</label>
      <input type="text" id="email" name="email" placeholder="admin@alsa.com" required>

      <label for="password">Senha:</label>
      <input type="password" id="password" name="password" placeholder="123456" required>

      <button type="submit">Entrar</button>
    </form>
  </div>
</body>
</html>
